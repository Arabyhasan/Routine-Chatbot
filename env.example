# Copy this file to .env, then replace only the values for services you use.
# Do not commit the resulting .env file.

# Choose one LLM provider.
ANTHROPIC_API_KEY=replace_me
GROQ_API_KEY=replace_me
GEMINI_API_KEY=replace_me

# Optional Slack integration.
SLACK_BOT_TOKEN=replace_me
SLACK_CHANNEL_IDS=meeting-times,general

# Optional Google integration. Obtain these via the documented OAuth flow.
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=token.json
ENABLE_GMAIL=false
ENABLE_CALENDAR=false
