# ─── LLM Provider (set ONE — priority: Claude > Groq > Gemini) ───────────────

# Option 1: Claude by Anthropic (paid, best quality)
# Get key: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# Option 2: Groq — FREE, no credit card, 14,400 req/day, full tool-use support
# Get key: https://console.groq.com  (takes 30 seconds, just email)
GROQ_API_KEY=gsk_...

# Option 3: Gemini by Google — FREE, Google account only
# Get key: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIza...

# Optional model overrides (defaults shown)
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ─── Slack (optional) ────────────────────────────────────────────────────────
# Get from: https://api.slack.com/apps → your app → OAuth & Permissions
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_IDS=meeting-times,general

# ─── Gmail / Google Sheets (optional) ────────────────────────────────────────
# Run `python google_integration.py` once to create token.json via browser OAuth
# GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials.json
# GOOGLE_CALENDAR_TOKEN_PATH=token.json
# ENABLE_GMAIL=true
# ENABLE_CALENDAR=true
